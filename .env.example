# Copia este archivo como .env y cambia los valores. Nunca subas .env al repositorio.

# --- PostgreSQL (lo usa infra/docker-compose.yml) ---
POSTGRES_USER=sismora
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=sismora

# --- API ---
# En produccion se pega la URL que da el proveedor: acepta postgres:// y postgresql://
DATABASE_URL=postgresql+psycopg://sismora:cambia_esta_clave@localhost:5432/sismora
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
SECRET_KEY=genera_una_clave_larga_con_openssl_rand_hex_32
CORS_ORIGINS=http://localhost:5173
# local | production. Con production la API NO arranca si SECRET_KEY es debil o de ejemplo,
# si CORS_ORIGINS usa http:// o si COOKIE_SECURE no es true.
ENVIRONMENT=local
COOKIE_SECURE=false
# Zona horaria para mostrar fechas al usuario. Los datos se guardan siempre en UTC.
DISPLAY_TIMEZONE=America/Lima

# --- Frontend (solo las variables VITE_* llegan al navegador) ---
VITE_API_BASE_URL=/api/v1
